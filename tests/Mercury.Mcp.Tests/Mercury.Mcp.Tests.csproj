<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the mercury-mcp tool surface (MercuryTools), called in process against a temporary store pool. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>SkyOmega.Mercury.Mcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mercury.Mcp\Mercury.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Mercury\Mercury.csproj" />
    <ProjectReference Include="..\..\src\Mercury.Runtime\Mercury.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
