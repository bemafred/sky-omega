<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for Mercury.Hosting (ADR-065 D11): a store served on the Generic Host, its HTTP endpoint and attach pipe,
       and its close when the host stops. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>SkyOmega.Mercury.Hosting.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mercury.Hosting\Mercury.Hosting.csproj" />
    <!-- mercuryd, run by the tests as a process of its own: its stop signals, its exit code and its store's lock are a
         process's (ADR-065 Step 4). -->
    <ProjectReference Include="..\..\src\Mercury.Daemon\Mercury.Daemon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
