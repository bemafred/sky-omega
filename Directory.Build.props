<Project>
  <PropertyGroup>
    <!-- Version information: AssemblyVersion, FileVersion and InformationalVersion derive from Version -->
    <Version>1.8.29</Version>

    <!-- Package metadata -->
    <Authors>Sky Omega Contributors</Authors>
    <Company>Sky Omega</Company>
    <Product>Sky Omega</Product>
    <Description>Semantic-aware storage and query engine with zero-GC performance design</Description>
    <Copyright>Copyright (c) 2026 Sky Omega Contributors</Copyright>

    <!-- Repository information -->
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build settings -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
