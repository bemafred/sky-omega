<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>drhook-mcp</AssemblyName>
        <RootNamespace>SkyOmega.DrHook.Mcp</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>drhook-mcp</ToolCommandName>
        <PackageId>SkyOmega.DrHook.Mcp</PackageId>
        <Authors>Sky Omega Contributors</Authors>
        <Description>DrHook MCP Server — .NET runtime inspection for Claude via Model Context Protocol.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" Version="0.8.0-preview.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- DrHook.Engine — the EventPipe diagnostics drhook_processes and drhook_snapshot read through
             (Diagnostics/ProcessAttacher + StackInspector, finding 52), the sinks behind the drain tools, and the
             worker protocol. drhook-mcp loads no debugger: the session runs in drhook-worker (ADR-016 6.7). -->
        <ProjectReference Include="..\DrHook.Engine\DrHook.Engine.csproj" />
        <!-- drhook-worker, the debugger's own process: built first, and carried in worker/ (below), not referenced. -->
        <ProjectReference Include="..\DrHook.Worker\DrHook.Worker.csproj" ReferenceOutputAssembly="false" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- The worker's own tests read which worker is in session (Supervisor.SessionWorkerPid). -->
        <InternalsVisibleTo Include="DrHook.Engine.IntegrationTests" />
    </ItemGroup>

    <!--
      The worker's own directory, in drhook-mcp's output and package (ADR-016 6.7): everything drhook-worker's build put
      in its output, at worker/ beside drhook-mcp. As ContentWithTargetPath items, so they are copied to drhook-mcp's
      output, to the output of a project that references drhook-mcp (the integration suite), and to the publish
      directory that `dotnet pack` packs a tool from.
    -->
    <Target Name="IncludeTheWorker" BeforeTargets="AssignTargetPaths">
        <MSBuild Projects="..\DrHook.Worker\DrHook.Worker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_DrHookWorkerTargetPath" />
        </MSBuild>
        <PropertyGroup>
            <_DrHookWorkerDirectory>@(_DrHookWorkerTargetPath->'%(RootDir)%(Directory)')</_DrHookWorkerDirectory>
        </PropertyGroup>
        <ItemGroup>
            <_DrHookWorkerFile Include="$(_DrHookWorkerDirectory)**\*" />
            <ContentWithTargetPath Include="@(_DrHookWorkerFile)"
                                   TargetPath="worker\%(RecursiveDir)%(Filename)%(Extension)"
                                   CopyToOutputDirectory="PreserveNewest"
                                   CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

</Project>
