<Project Sdk="Microsoft.NET.Sdk">

    <!-- What a process that holds one store does, for each Mercury tool that holds one: mercury, mercury-mcp and
         mercuryd (ADR-065 D11). BCL only: the CLI runs no Generic Host, so the hosting package is in Mercury.Hosting. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>SkyOmega.Mercury.Serving</AssemblyName>
        <RootNamespace>SkyOmega.Mercury.Serving</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mercury\Mercury.csproj" />
        <ProjectReference Include="..\Mercury.Pruning\Mercury.Pruning.csproj" />
        <ProjectReference Include="..\Mercury.Runtime\Mercury.Runtime.csproj" />
    </ItemGroup>

</Project>
