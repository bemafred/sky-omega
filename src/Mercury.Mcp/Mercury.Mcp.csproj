<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>mercury-mcp</AssemblyName>
        <RootNamespace>SkyOmega.Mercury.Mcp</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mercury-mcp</ToolCommandName>
        <PackageId>SkyOmega.Mercury.Mcp</PackageId>
        <Authors>Sky Omega Team</Authors>
        <Description>Mercury MCP Server - semantic memory for Claude via Model Context Protocol.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" Version="0.8.0-preview.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- The store, its endpoints and the stop handling (ADR-065 D11); the Generic Host comes with it. -->
        <ProjectReference Include="..\Mercury.Hosting\Mercury.Hosting.csproj" />
    </ItemGroup>

</Project>
