<Project Sdk="Microsoft.NET.Sdk">

    <!-- What a process that holds one store until it is stopped does, on the .NET Generic Host: mercury-mcp and
         mercuryd (ADR-065 D11). -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>SkyOmega.Mercury.Hosting</AssemblyName>
        <RootNamespace>SkyOmega.Mercury.Hosting</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mercury.Serving\Mercury.Serving.csproj" />
    </ItemGroup>

</Project>
